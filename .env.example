# Zernio (Instagram & Multi-channel API)
ZERNIO_API_KEY=
ZERNIO_BASE_URL=https://zernio.com/api/v1

# Telegram
TELEGRAM_BOT_TOKEN=


# Optional: Local Bot API base for files >50MB (e.g. http://127.0.0.1:8081)
# TELEGRAM_API_BASE=https://api.telegram.org

# Delivery tuning
# DELIVERY_BATCH_SIZE=8
# DELIVERY_MAX_FILE_MB=100

# Supabase (server)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase (client / Vite)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# App URL (used for product images in Telegram)
PUBLIC_APP_URL=https://your-project.vercel.app

# Which tenant row in the shared `bots` table this deployment serves. Required —
# module flags and bot status (active/paused/suspended) are read from
# bots.modules / bots.status for this id, see src/lib/modules/modules.server.ts.
BOT_ID=

# Admin session (set a long random string in production)
SESSION_SECRET=

# Vercel Cron / self-heal webhook (random string; same value in cron-job.org)
CRON_SECRET=

# Optional: Telegram webhook secret_token (if set, must match setWebhook)
TELEGRAM_WEBHOOK_SECRET=

# Optional: Google Cloud Vision API key — OCR check for auto-delivery receipts (±10% amount)
# Without it, receipt auto-delivery falls back to manual admin confirmation.
# GOOGLE_VISION_API_KEY=

# ── Operator control panel — ONLY set these on the panel's own Vercel project. ──
# Never set CONTROL_PLANE on a client deployment: it's the first of three
# isolation layers for /operator/* — see CONTROL-PLANE-PLAN.md §2.
# CONTROL_PLANE=1
# OPERATOR_SESSION_SECRET=
# OPERATOR_USERNAME=
# OPERATOR_PASSWORD=
#
# Панели нужен и SUPABASE_JWT_SECRET — им подписываются SUPABASE_TENANT_KEY
# при подключении клиента. Клиентским деплоям он не нужен и не должен быть
# задан: этим секретом можно выпустить ключ к данным ЛЮБОГО клиента.
# SUPABASE_JWT_SECRET=
#
# Ежедневный обход подписок (предупредить / приостановить по политике) —
# внешним планировщиком, как и у клиентских деплоев:
#   GET https://<панель>/api/operator-cron/subscriptions?secret=$CRON_SECRET
# В vercel.json расписание не заводить: файл общий для всех шести проектов,
# и крон запускался бы ещё и у клиентов.


